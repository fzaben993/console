{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        "paths": {
            "$lib/*": ["./src/lib/*"],
            "$routes/*": ["./src/routes/*"],
            "$themes/*": ["./src/themes/*"]
        }
    },
    "include": [
        "src/main.tsx",
        "src/App.tsx",
        "src/app.css",
        "src/components/**/*.tsx",
        "src/pages/**/*.tsx",
        "src/vite-env.d.ts",
        "vitest-setup-react.ts"
    ],
    "exclude": ["src/routes/**/*", "src/lib/**/*", "vite.config.ts"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
